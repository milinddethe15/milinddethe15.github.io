---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getAllTags } from '@/lib/content';
import { url } from '@/lib/utils';

const tags = siteConfig.features.tags && siteConfig.features.posts ? await getAllTags() : [];
// See the note in tags/[tag]/[...page].astro — inline this and the space is lost.
const topicCount = `${tags.length} ${tags.length === 1 ? 'topic' : 'topics'}`;
---

<BaseLayout title="Tags" description="Browse all post topics and tags.">
  <div class="container-page py-10 sm:py-14">
    <header>
      <h1 class="text-2xl sm:text-3xl">Tags</h1>
      <p class="mt-3 text-base opacity-75">{topicCount} across all posts.</p>
    </header>

    <ul class="mt-8 border-t border-border">
      {
        tags.map(({ tag, slug, count }) => (
          <li class="border-b border-dashed border-border">
            <a
              href={url(`/tags/${slug}`)}
              class="group flex items-baseline justify-between gap-4 py-3 transition-opacity hover:opacity-60"
            >
              <span class="text-base font-medium">{tag}</span>
              <span class="shrink-0 text-xs opacity-60">
                {count} {count === 1 ? 'post' : 'posts'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
