---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tagSlug } from '../../data/util';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const bySlug = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      const entry = bySlug.get(slug) ?? { tag, posts: [] };
      entry.posts.push(post);
      bySlug.set(slug, entry);
    }
  }
  return [...bySlug.entries()].map(([slug, { tag, posts: tagged }]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: tagged.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
---

<Base title={`#${tag} · @milinddethe15`} description={`Posts tagged ${tag}.`}>
  <div class="container narrow">
    <div class="page-head">
      <p class="kicker">~/tags</p>
      <h1>#{tag}</h1>
      <p class="lede">{posts.length} post{posts.length === 1 ? '' : 's'}, oldest first.</p>
    </div>
    <section style="padding-bottom: 90px;">
      {
        posts.map((post) => (
          <a class="post-line" href={`/posts/${post.id}/`}>
            <span>{post.data.title}</span>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </a>
        ))
      }
    </section>
  </div>
</Base>
