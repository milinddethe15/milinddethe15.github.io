---
import Base from '../layouts/Base.astro';
---

<Base title="404 · @milinddethe15" description="Page not found." noindex>
  <div class="container narrow" style="padding-block: 96px 160px;">
    <p class="kicker">HTTP 404</p>
    <h1 style="font-size: 2.1rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 10px;">
      Page not found
    </h1>
    <p style="color: var(--text-dim); margin-top: 12px; max-width: 52ch;">
      This pod has been evicted. Let's reschedule you somewhere healthy.
    </p>
    <p class="intro__links">
      <a href="/">← back home</a>
      <span>·</span>
      <a href="/posts/">read posts</a>
    </p>
  </div>
</Base>
