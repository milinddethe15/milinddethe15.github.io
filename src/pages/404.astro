---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/utils';
---

<BaseLayout title="404 — Page not found" description="This page could not be found." noindex>
  <div
    class="container-page flex min-h-[calc(100dvh-14rem)] flex-col items-center justify-center py-20 text-center"
  >
    <h1 class="text-[clamp(4rem,14vw,7rem)] leading-none">404</h1>
    <h2 class="mt-4 font-sans text-xl font-medium tracking-normal opacity-80">Page not found</h2>
    <p class="mt-3 text-base opacity-70">
      Sorry, this page does not exist.<br />
      You can head back to <a href={url('/')} class="link-dotted">the homepage</a>.
    </p>
    <p class="mt-6 font-mono text-xs opacity-40" id="requested-path"></p>
  </div>
</BaseLayout>

<script>
  const el = document.getElementById('requested-path');
  if (el) el.textContent = location.pathname;
</script>
