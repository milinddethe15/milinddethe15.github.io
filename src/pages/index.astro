---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { personSchema } from '@/lib/seo';
import { url, inlineMarkdown } from '@/lib/utils';
import { getRecentPosts, getFeaturedProjects } from '@/lib/content';
import { EXPERIENCE, OSS, OSS_ALL_URL, fetchMergedPrCount } from '@/data/resume';
import SocialLinks from '@/components/layout/SocialLinks.astro';
import Section from '@/components/ui/Section.astro';
import PostRow from '@/components/posts/PostRow.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';

const { author, home, features } = siteConfig;
const posts = features.posts && home.recentPosts > 0 ? await getRecentPosts(home.recentPosts) : [];
const projects =
  features.projects && home.featuredProjects > 0
    ? await getFeaturedProjects(home.featuredProjects)
    : [];
const mergedPrs = await fetchMergedPrCount();
const hasSectionsBelow = posts.length > 0 || projects.length > 0 || EXPERIENCE.length > 0;
---

<BaseLayout jsonLd={[personSchema()]}>
  <div class="container-page">
    {/* Hero — fills the viewport below the sticky header; everything else lives under the fold */}
    <section
      class="animate-fade-up relative flex min-h-[calc(100dvh-3.5rem)] flex-col items-center justify-center py-16 text-center"
    >
      <img
        src={url(author.avatar)}
        alt={`Portrait of ${author.name}`}
        width="160"
        height="160"
        fetchpriority="high"
        class="size-28 rounded-full border border-border bg-surface object-cover transition-transform hover:scale-[1.02] sm:size-36"
      />
      <h1 class="mt-8 text-[clamp(1.9rem,5vw,3.1rem)] text-balance">{author.name}</h1>
      {
        author.tagline && (
          <p class="mt-4 max-w-[26ch] text-lg leading-snug text-balance opacity-90 sm:max-w-none sm:text-xl">
            {author.tagline}
          </p>
        )
      }
      {
        author.info.length > 0 && (
          <p class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-base opacity-80 sm:text-lg [&_a]:link-dotted [&_code]:rounded [&_code]:border [&_code]:border-border [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em]">
            {author.info.map((line, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class="opacity-40">
                    ·
                  </span>
                )}
                <span set:html={inlineMarkdown(line)} />
              </>
            ))}
          </p>
        )
      }

      <SocialLinks class="mt-8" />

      {
        hasSectionsBelow && (
          <a
            href="#below-the-fold"
            aria-label="Scroll to content"
            class="scroll-cue absolute bottom-5 left-1/2 -translate-x-1/2 opacity-40 transition-opacity hover:opacity-100 focus-visible:opacity-100"
          >
            <Icon name="chevron-down" size={22} />
          </a>
        )
      }
    </section>

    <div id="below-the-fold" class="scroll-mt-14"></div>

    {
      EXPERIENCE.length > 0 && (
        <Section title="experience" class="mt-10 sm:mt-14">
          <ul>
            {EXPERIENCE.map((role) => (
              <li class="border-b border-dashed border-border py-4 last:border-b-0 sm:grid sm:grid-cols-[9.5rem_1fr] sm:gap-6">
                <p class="text-[0.8125rem] whitespace-nowrap opacity-50 sm:pt-1">{role.when}</p>
                <div class="mt-1 sm:mt-0">
                  <h3 class="font-sans text-base font-medium tracking-[0.01em]">
                    <a
                      href={role.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-dotted"
                    >
                      {role.org}
                    </a>
                    <span class="opacity-60"> — {role.role}</span>
                  </h3>
                  <p class="mt-1.5 text-[0.9375rem] leading-relaxed opacity-75">{role.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    {
      posts.length > 0 && (
        <Section title="latest posts" href="/posts">
          <ul>
            {posts.map((post) => (
              <PostRow post={post} />
            ))}
          </ul>
        </Section>
      )
    }

    {
      projects.length > 0 && (
        <Section title="selected projects" href="/projects">
          <div class="grid gap-5 sm:grid-cols-2">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </Section>
      )
    }

    {
      OSS.length > 0 && (
        <Section title="open source" href={OSS_ALL_URL} linkLabel={`${mergedPrs} merged upstream`}>
          <ul>
            {OSS.map((pr) => (
              <li class="border-b border-dashed border-border last:border-b-0">
                <a
                  href={pr.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 py-3 transition-opacity hover:opacity-60"
                >
                  <span class="text-[0.9375rem] font-medium">{pr.title}</span>
                  <span class="font-mono text-xs opacity-50">{pr.repo}</span>
                </a>
              </li>
            ))}
          </ul>
        </Section>
      )
    }
  </div>
</BaseLayout>
