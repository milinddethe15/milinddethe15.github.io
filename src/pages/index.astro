---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, PROJECTS, EXPERIENCE, OSS, OSS_ALL_URL } from '../data/site';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// Merged-PR count fetched once per build; falls back to the last known
// count if the GitHub API is unreachable.
let ossCount = 61;
try {
  const res = await fetch(
    'https://api.github.com/search/issues?per_page=1&q=' +
      encodeURIComponent('is:pr is:merged author:milinddethe15 -user:milinddethe15'),
    {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'milinddethe15.tech-build',
        ...(process.env.GITHUB_TOKEN
          ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` }
          : {}),
      },
    }
  );
  if (res.ok) ossCount = (await res.json()).total_count ?? ossCount;
} catch {}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: 'https://milinddethe15.tech/',
  image: 'https://milinddethe15.tech/images/dp.jpg',
  jobTitle: 'Platform / DevOps Engineer',
  sameAs: [SITE.github, SITE.linkedin, SITE.x],
});
---

<Base>
  <section class="container narrow intro">
    <p class="kicker kicker--prompt" aria-hidden="true">whoami</p>
    <div class="intro__grid">
      <div>
        <h1>Milind Dethe</h1>
        <p class="intro__headline">
          Building boring, reliable infrastructure<br />
          for the cloud-native world.
        </p>
      </div>
      <dl class="intro__facts">
        <div>
          <dt>edu</dt>
          <dd><a href="https://www.iitkgp.ac.in/" rel="noopener" target="_blank">IIT KGP</a> '26</dd>
        </div>
        <div>
          <dt>prev</dt>
          <dd><a href="https://atlan.com" rel="noopener" target="_blank">Atlan</a> · platform</dd>
        </div>
        <div>
          <dt>oss</dt>
          <dd>
            LFX '24 <a href="https://thanos.io" rel="noopener" target="_blank">Thanos</a> ·
            <a href="https://github.com/kubeflow" rel="noopener" target="_blank">Kubeflow</a>
          </dd>
        </div>
        <div>
          <dt>cert</dt>
          <dd>
            <a href="https://www.cncf.io/training/certification/cka/" rel="noopener" target="_blank"
              >CKA</a
            > · Aug 2026
          </dd>
        </div>
      </dl>
    </div>
    <p class="intro__sub">
      <span>platform</span>
      <span class="dot">·</span>
      <span>devops</span>
      <span class="dot">·</span>
      <span>kubernetes</span>
      <span class="dot">·</span>
      <span>ai infra</span>
    </p>
    <p class="intro__links">
      <a href={SITE.resume} rel="noopener" target="_blank"
        >resume <Icon name="arrow" class="arrow-icon" /></a
      >
      <span>·</span>
      <a href={`mailto:${SITE.email}`}>email</a>
      <span>·</span>
      <a href={SITE.github} rel="me noopener" target="_blank">github</a>
      <span>·</span>
      <a href={SITE.linkedin} rel="me noopener" target="_blank">linkedin</a>
      <span>·</span>
      <a href={SITE.x} rel="me noopener" target="_blank">x/twitter</a>
    </p>
  </section>

  <section class="container section narrow" aria-label="Experience">
    <div class="section-label">
      <h2>experience</h2>
    </div>
    {
      EXPERIENCE.map((e) => (
        <div class="exp-row">
          <div class="exp-row__when">{e.when}</div>
          <div>
            <h3>
              <a href={e.url} rel="noopener" target="_blank">
                {e.org}
              </a>{' '}
              <span>— {e.role}</span>
            </h3>
            <p>{e.detail}</p>
          </div>
        </div>
      ))
    }
  </section>

  <section class="container section narrow" aria-label="Projects" style="padding-top: 0;">
    <div class="section-label">
      <h2>projects</h2>
      <a href="/projects/">see all <Icon name="arrow" class="arrow-icon" /></a>
    </div>
    {
      // homepage shows real repos only; the blog-series entries
      // (internal /tags/ links) live on the full projects page
      PROJECTS.filter((p) => p.source.startsWith('http')).map((p) => (
        <a
          class="proj-row"
          href={p.source}
          rel={p.source.startsWith('http') ? 'noopener' : undefined}
          target={p.source.startsWith('http') ? '_blank' : undefined}
        >
          <span class="proj-row__top">
            <span class="proj-row__name">{p.title}</span>
            <span class="proj-row__skills">{p.skills.map((s) => s.toLowerCase()).join(' · ')}</span>
          </span>
          <span class="proj-row__desc">{p.description}</span>
        </a>
      ))
    }
  </section>

  <section class="container section narrow" aria-label="Open source" style="padding-top: 0;">
    <div class="section-label">
      <h2>open source</h2>
      <a href={OSS_ALL_URL} rel="noopener" target="_blank">
        {ossCount} merged upstream <Icon name="arrow" class="arrow-icon" />
      </a>
    </div>
    {
      OSS.map((o) => (
        <a class="oss-row" href={o.url} rel="noopener" target="_blank">
          <span class="oss-row__dot" aria-hidden="true" />
          <span class="oss-row__title">{o.title}</span>
          <span class="oss-row__repo">{o.repo}</span>
        </a>
      ))
    }
  </section>

  <section class="container section narrow" aria-label="Writing" style="padding-top: 0;">
    <div class="section-label">
      <h2>writing</h2>
      <a href="/posts/">see all <Icon name="arrow" class="arrow-icon" /></a>
    </div>
    {
      posts.map((post) => (
        <a class="post-line" href={`/posts/${post.id}/`}>
          <span>{post.data.title}</span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        </a>
      ))
    }
  </section>

  <script is:inline type="application/ld+json" set:html={personLd} />
</Base>
