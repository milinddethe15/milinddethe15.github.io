---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import { siteConfig } from '@/config/site';
import { getProjects, hasDetailPage } from '@/lib/content';
import Callout from '@/components/ui/Callout.astro';
import Tabs from '@/components/ui/Tabs.astro';

export const getStaticPaths = (async () => {
  if (!siteConfig.features.projects) return [];
  const projects = await getProjects();
  return projects.filter(hasDetailPage).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<ProjectLayout project={project} headings={headings}>
  <Content components={{ Callout, Tabs }} />
</ProjectLayout>
