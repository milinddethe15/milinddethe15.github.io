---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getProjects } from '@/lib/content';
import ProjectCard from '@/components/projects/ProjectCard.astro';

const projects = siteConfig.features.projects ? await getProjects() : [];
const skills = [...new Set(projects.flatMap((p) => p.data.skills))].sort((a, b) =>
  a.localeCompare(b),
);
const filterClass =
  'cursor-pointer rounded-full border border-border bg-surface px-3 py-1 text-xs lowercase tracking-wide opacity-70 transition-[opacity,border-color] aria-pressed:border-foreground aria-pressed:opacity-100 hover:opacity-100';
---

<BaseLayout title="Projects" description="Selected work, collaborations, and personal projects.">
  <div class="container-wide py-10 sm:py-14">
    <header class="max-w-[48rem]">
      <h1 class="text-2xl sm:text-3xl">Projects</h1>
      <p class="mt-3 text-base opacity-75">Selected work, collaborations, and personal projects.</p>
    </header>

    {/* Skill filter — progressive enhancement, no page reload */}
    {
      skills.length > 1 && (
        <div class="mt-6 flex flex-wrap gap-1.5" id="project-filters">
          <button type="button" data-filter="" aria-pressed="true" class={filterClass}>
            all
          </button>
          {skills.map((skill) => (
            <button type="button" data-filter={skill} aria-pressed="false" class={filterClass}>
              {skill}
            </button>
          ))}
        </div>
      )
    }

    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
      {
        projects.map((project) => (
          <li data-skills={project.data.skills.join('|')}>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>

    <p id="project-empty" hidden class="mt-10 text-center text-sm opacity-60">
      No projects match this filter.
    </p>
  </div>
</BaseLayout>

<script>
  function initProjectFilters() {
    const filters = document.querySelectorAll<HTMLButtonElement>('#project-filters [data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('#project-grid [data-skills]');
    const empty = document.getElementById('project-empty');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? '';
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

        let visible = 0;
        cards.forEach((card) => {
          const match = filter === '' || (card.dataset.skills ?? '').split('|').includes(filter);
          card.hidden = !match;
          if (match) visible++;
        });
        if (empty) empty.hidden = visible > 0;
      });
    });
  }
  initProjectFilters();
</script>
