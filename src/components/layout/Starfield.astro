---
/**
 * The starfield behind the page: a slowly rotating cloud of a thousand stars
 * with pointer parallax, drawn on a plain 2D canvas with a hand-rolled
 * perspective projection — no dependencies, ~1.5 KB of script.
 *
 * Draws in the current foreground colour, pauses in hidden tabs, and holds a
 * single static frame for visitors who prefer reduced motion.
 * Turn it off with `features.starfield: false` in src/config/site.ts.
 */
---

<canvas id="starfield" aria-hidden="true"></canvas>

<script>
  const COUNT = 1000;
  const SPREAD = 10;
  const CAMERA_Z = 5;
  const FOV = (75 * Math.PI) / 180;
  const POINT_SIZE = 0.015;

  function initStarfield() {
    const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const points = new Float32Array(COUNT * 3);
    for (let i = 0; i < points.length; i++) points[i] = (Math.random() - 0.5) * SPREAD;

    let width = 0;
    let height = 0;
    let color = '#ffffff';
    let alpha = 0.35;
    let pointerX = 0;
    let pointerY = 0;
    let raf = 0;
    const start = performance.now();

    const readTheme = () => {
      const dark = document.documentElement.classList.contains('dark');
      const fg = getComputedStyle(document.documentElement).getPropertyValue('--foreground').trim();
      color = fg || (dark ? '#ffffff' : '#000000');
      alpha = dark ? 0.35 : 0.4;
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      width = innerWidth;
      height = innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = color;
      ctx.globalAlpha = alpha;

      const focal = height / 2 / Math.tan(FOV / 2);
      const cx = width / 2;
      const cy = height / 2;
      // Object rotation (the cloud itself) and camera rotation (parallax).
      const cosY = Math.cos(time * 0.06);
      const sinY = Math.sin(time * 0.06);
      const cosX = Math.cos(time * 0.03);
      const sinX = Math.sin(time * 0.03);
      const cosCY = Math.cos(-pointerX * 0.1);
      const sinCY = Math.sin(-pointerX * 0.1);
      const cosCX = Math.cos(-pointerY * 0.1);
      const sinCX = Math.sin(-pointerY * 0.1);

      for (let i = 0; i < COUNT; i++) {
        const x0 = points[i * 3]!;
        const y0 = points[i * 3 + 1]!;
        const z0 = points[i * 3 + 2]!;

        // Rotate the cloud around Y, then X.
        const x1 = x0 * cosY + z0 * sinY;
        let z1 = -x0 * sinY + z0 * cosY;
        const y1 = y0 * cosX - z1 * sinX;
        z1 = y0 * sinX + z1 * cosX - CAMERA_Z;

        // Inverse camera rotation.
        const x = x1 * cosCY + z1 * sinCY;
        let z = -x1 * sinCY + z1 * cosCY;
        const y = y1 * cosCX - z * sinCX;
        z = y1 * sinCX + z * cosCX;

        const depth = -z;
        if (depth < 0.4) continue;
        const sx = cx + (x * focal) / depth;
        const sy = cy - (y * focal) / depth;
        if (sx < -2 || sx > width + 2 || sy < -2 || sy > height + 2) continue;

        const size = Math.min(3, Math.max(0.6, (POINT_SIZE * (height / 2)) / depth));
        ctx.beginPath();
        ctx.arc(sx, sy, size / 2, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const tick = (now: number) => {
      draw((now - start) / 1000);
      raf = requestAnimationFrame(tick);
    };
    const play = () => {
      if (reduced.matches) {
        draw(0);
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const pause = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    resize();
    readTheme();
    play();

    addEventListener(
      'resize',
      () => {
        resize();
        if (reduced.matches) draw(0);
      },
      { passive: true },
    );
    addEventListener(
      'pointermove',
      (event) => {
        pointerX = (event.clientX / innerWidth - 0.5) * 2;
        pointerY = -(event.clientY / innerHeight - 0.5) * 2;
      },
      { passive: true },
    );
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    reduced.addEventListener('change', () => {
      pause();
      play();
    });
    new MutationObserver(() => {
      readTheme();
      if (reduced.matches) draw(0);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  initStarfield();
</script>
