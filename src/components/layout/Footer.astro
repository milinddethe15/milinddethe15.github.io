---
import { siteConfig } from '@/config/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const { since, text, credit } = siteConfig.footer;
const themeUrl = 'https://www.paypal.com/ncp/payment/KT2A3TSWWWH9N';
const range = since && since < year ? `${since} – ${year}` : `${year}`;
const copyright = `© ${range} ${siteConfig.author.name}`;
---

<footer class="mt-24 border-t border-border">
  <div
    class="container-page flex flex-col items-center gap-3 py-8 text-center text-xs text-muted-foreground"
  >
    <SocialLinks size={16} withRss />
    <p>
      {copyright}
      {text && <span> · {text}</span>}
      {
        credit && (
          <>
            <span> · Powered by </span>
            <a
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/80 underline decoration-dotted underline-offset-4 transition-colors hover:text-foreground hover:decoration-solid"
            >
              Astro
            </a>
            <span> & </span>
            <a
              href={themeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/80 underline decoration-dotted underline-offset-4 transition-colors hover:text-foreground hover:decoration-solid"
            >
              Mono
            </a>
          </>
        )
      }
    </p>
  </div>
</footer>
