---
import { cn } from '@/lib/utils';

interface Props {
  /** Renders an <a> when set, otherwise a <button> */
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  type = 'button',
  external = false,
  ...rest
} = Astro.props;

const classes = cn(
  'inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border font-medium tracking-wide transition-[opacity,transform,background-color] hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50',
  variant === 'primary' && 'border-foreground bg-foreground text-background hover:opacity-85',
  variant === 'secondary' && 'border-border bg-surface text-foreground hover:border-foreground/60',
  variant === 'ghost' && 'border-transparent text-foreground/70 hover:text-foreground',
  size === 'sm' && 'h-8 px-3.5 text-xs',
  size === 'md' && 'h-10 px-5 text-sm',
  className,
);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
