---
import { url } from '@/lib/utils';
import Icon from './Icon.astro';

interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol
    class="flex flex-wrap items-center gap-1 text-xs lowercase tracking-wide text-muted-foreground"
  >
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="chevron-right" size={12} class="opacity-60" />}
          {item.href ? (
            <a href={url(item.href)} class="transition-colors hover:text-foreground">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-foreground">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
