const { name, class: className, size = 16 } = Astro.props;
const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.type === 'fill' ? 'currentColor' : 'none'}
  stroke={icon.type === 'stroke' ? 'currentColor' : 'none'}
  stroke-width={icon.type === 'stroke' ? 2 : undefined}
  stroke-linecap={icon.type === 'stroke' ? 'round' : undefined}
  stroke-linejoin={icon.type === 'stroke' ? 'round' : undefined}
  class={className}
  aria-hidden="true"
  set:html={icon.body}
/>
