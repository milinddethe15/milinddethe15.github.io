---
import { SITE } from '../data/site';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/posts/', label: 'Posts' },
  { href: '/projects/', label: 'Projects' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // stamp the saved theme before first paint (no flash of the wrong
      // theme) and preload that theme's wallpaper — not the default's
      {
        let t = 'matte';
        try {
          const saved = localStorage.getItem('theme');
          if (['twilight', 'aurora', 'indigo', 'sand'].includes(saved)) {
            document.documentElement.dataset.theme = saved;
            t = saved;
          }
        } catch {}
        const link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.href = '/images/bg-' + t + '.webp';
        document.head.append(link);
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#1c1c1e" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/index.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <noscript>
      <link rel="preload" as="image" href="/images/bg-matte.webp" />
    </noscript>
    {
      // Every weight used above the fold — preload them all to kill font swap.
      ['400', '500', '700'].map((w) => (
        <link
          rel="preload"
          href={`/fonts/space-grotesk/SpaceGrotesk-latin-${w}-normal.woff2`}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Milind Dethe — building boring, reliable infrastructure for the cloud-native world" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@milinddethe15" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="edge-fade edge-fade--top" aria-hidden="true"></div>
    <div class="edge-fade edge-fade--bottom" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container narrow">
        <div class="site-header__bar">
          <a class="site-header__logo" href="/">milinddethe15</a>
          <nav class="site-header__nav">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={current.startsWith(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <div class="theme-menu">
              <button
                class="theme-menu__btn"
                type="button"
                aria-label="Switch theme"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <Icon name="theme" />
              </button>
              <div class="theme-menu__pop" hidden>
                <button type="button" data-theme-opt="matte">matte</button>
                <button type="button" data-theme-opt="twilight">twilight</button>
                <button type="button" data-theme-opt="indigo">indigo</button>
                <button type="button" data-theme-opt="aurora">aurora</button>
                <button type="button" data-theme-opt="sand">sand</button>
                <p class="theme-menu__hint">press t to cycle</p>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="container narrow site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <nav aria-label="Social links">
        <a class="site-footer__resume" href={SITE.resume} rel="noopener" target="_blank">
          resume <Icon name="arrow" class="arrow-icon" />
        </a>
        <a href={SITE.github} rel="me noopener" target="_blank" aria-label="GitHub">
          <Icon name="github" />
        </a>
        <a href={SITE.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn">
          <Icon name="linkedin" />
        </a>
        <a href={SITE.x} rel="me noopener" target="_blank" aria-label="Twitter / X">
          <Icon name="x" />
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email">
          <Icon name="email" />
        </a>
        <a href="/index.xml" aria-label="RSS feed">
          <Icon name="rss" />
        </a>
      </nav>
    </footer>

    <a class="to-top" href="#top" aria-label="Back to top">
      <Icon name="back" />
    </a>

    <script is:inline>
      // copy buttons for code blocks (posts)
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.replaceWith(wrap);
        wrap.append(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.textContent = 'copy';
        btn.addEventListener('click', () => {
          navigator.clipboard?.writeText(pre.innerText).then(() => {
            btn.textContent = '✓ copied';
            btn.classList.add('code-copy--done');
            setTimeout(() => {
              btn.textContent = 'copy';
              btn.classList.remove('code-copy--done');
            }, 1500);
          });
        });
        wrap.append(btn);
      });
    </script>

    <script is:inline>
      // Nav states: capsule background appears once the page scrolls
      // (bare links over the hero at the top); the pill tucks away on
      // scroll-down and returns on any scroll-up. On pointer devices,
      // hovering the top edge also summons it (pure CSS).
      {
        const header = document.querySelector('.site-header');
        let last = scrollY;
        const update = () => {
          const y = Math.max(0, scrollY);
          header.classList.toggle('site-header--solid', y > 24);
          if (y > last + 2 && y > 140) header.classList.add('site-header--tucked');
          else if (y < last - 2) header.classList.remove('site-header--tucked');
          last = y;
        };
        update();
        addEventListener('scroll', update, { passive: true });
      }
    </script>

    <script is:inline>
      // theme switcher: nav menu + `t` cycles; choice persists in localStorage
      {
        const root = document.documentElement;
        const menu = document.querySelector('.theme-menu');
        const btn = menu.querySelector('.theme-menu__btn');
        const pop = menu.querySelector('.theme-menu__pop');
        const meta = document.querySelector('meta[name="theme-color"]');
        // key order = `t` cycle order: neutral → purple → blue → teal →
        // light
        const colors = {
          matte: '#1c1c1e',
          twilight: '#17121f',
          indigo: '#16132e',
          aurora: '#0e141b',
          sand: '#e7dfd0',
        };
        const THEMES = Object.keys(colors);
        const current = () => root.dataset.theme || 'matte';
        const paint = () => {
          pop.querySelectorAll('[data-theme-opt]').forEach((b) => {
            b.setAttribute('aria-pressed', String(b.dataset.themeOpt === current()));
          });
          meta.content = colors[current()];
        };
        let toast, toastTimer;
        const showToast = (msg, ms, tip) => {
          if (!toast) {
            toast = document.createElement('div');
            toast.setAttribute('role', 'status');
            document.body.append(toast);
          }
          toast.className = 'theme-toast' + (tip ? ' theme-toast--tip' : '');
          toast.textContent = msg;
          requestAnimationFrame(() => toast.classList.add('theme-toast--show'));
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => toast.classList.remove('theme-toast--show'), ms || 1800);
        };
        const apply = (t) => {
          if (t === 'matte') delete root.dataset.theme;
          else root.dataset.theme = t;
          try {
            localStorage.setItem('theme', t);
          } catch {}
          paint();
        };
        const close = () => {
          pop.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', () => {
          pop.hidden = !pop.hidden;
          btn.setAttribute('aria-expanded', String(!pop.hidden));
        });
        pop.addEventListener('click', (e) => {
          const b = e.target.closest('[data-theme-opt]');
          if (!b) return;
          apply(b.dataset.themeOpt);
          close();
        });
        document.addEventListener('click', (e) => {
          if (!pop.hidden && !menu.contains(e.target)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !pop.hidden) {
            close();
            btn.focus();
            return;
          }
          if (e.key !== 't' || e.ctrlKey || e.metaKey || e.altKey) return;
          if (e.target.closest?.('input, textarea, select, [contenteditable]')) return;
          const next = THEMES[(THEMES.indexOf(current()) + 1) % THEMES.length];
          apply(next);
          showToast('theme: ' + next);
        });
        paint();
        // one-time hint so visitors learn the shortcut
        try {
          if (!localStorage.getItem('theme-tip')) {
            localStorage.setItem('theme-tip', '1');
            setTimeout(() => showToast('press t to switch themes', 3500, true), 1200);
          }
        } catch {}
        // after the page settles, warm the cache with the other themes'
        // wallpapers (~130KB total) so switching swaps instantly
        addEventListener('load', () => {
          if (navigator.connection?.saveData) return;
          const warm = () => {
            THEMES.filter((n) => n !== current()).forEach((n) => {
              const img = new Image();
              img.fetchPriority = 'low';
              img.src = '/images/bg-' + n + '.webp';
            });
          };
          if ('requestIdleCallback' in window) requestIdleCallback(warm, { timeout: 3000 });
          else setTimeout(warm, 800);
        });
      }
    </script>

    <script is:inline define:vars={{ email: SITE.email }}>
      // Email links copy the address and confirm with a small tip right
      // above the clicked link. Falls back to mailto: if clipboard is
      // unavailable.
      let tip, timer;
      document.addEventListener('click', (e) => {
        const link = e.target.closest?.('a[href^="mailto:"]');
        if (!link || !navigator.clipboard) return;
        e.preventDefault();
        navigator.clipboard
          .writeText(email)
          .then(() => {
            if (!tip) {
              tip = document.createElement('div');
              tip.className = 'copy-tip';
              tip.setAttribute('role', 'status');
              tip.textContent = 'copied';
              document.body.append(tip);
            }
            const r = link.getBoundingClientRect();
            tip.style.left = r.left + r.width / 2 + 'px';
            tip.style.top = r.top - 8 + 'px';
            requestAnimationFrame(() => tip.classList.add('copy-tip--show'));
            clearTimeout(timer);
            timer = setTimeout(() => tip.classList.remove('copy-tip--show'), 1600);
          })
          .catch(() => {
            location.href = link.href;
          });
      });
    </script>

    {
      SITE.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.cloudflareToken}"}`}
        />
      )
    }
    {
      SITE.gaId && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
      )
    }
    {
      SITE.gaId && (
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      )
    }
  </body>
</html>
